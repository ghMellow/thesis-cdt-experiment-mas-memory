{"version":"2.1.0","runs":[{"invocations":[{"executionSuccessful":true,"toolExecutionNotifications":[]}],"results":[{"fingerprints":{"matchBasedId/v1":"31699f79f133839272a5dfaa2fccda7da618bc6fa8b7cf6b43a24d3a7ad2f4abe14d07bb3370364c2eee127add198e586f53dca3ebf3b2f2bdd47a52a586ec9d_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":".github/workflows/commit-msg-check.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":34,"endLine":12,"snippet":{"text":"      - uses: actions/checkout@v4"},"startColumn":9,"startLine":12}}}],"message":{"text":"GitHub Actions step uses a mutable tag or branch reference. Tags and branch names can be silently repointed by the action owner, enabling supply-chain attacks — as seen in the trivy-action and kics-github-action compromises. Pin the reference to a full 40-character commit SHA instead, e.g. `uses: actions/checkout@8ade135a41bc03ea155e62e844d188df1ea18608`."},"properties":{},"ruleId":"yaml.github-actions.security.github-actions-mutable-action-tag.github-actions-mutable-action-tag"},{"fingerprints":{"matchBasedId/v1":"4dbf69f923c55216148239e2a71ba8dc987f75d7ceae457462c473dd69241cb134f0801bd05a9ef2811e5ad240eddddefefd8630ee9a5f487450d6c3294f95e6_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":".github/workflows/commit-msg-check.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":56,"endLine":13,"snippet":{"text":"      - uses: webiny/action-conventional-commits@v1.3.0"},"startColumn":9,"startLine":13}}}],"message":{"text":"GitHub Actions step uses a mutable tag or branch reference. Tags and branch names can be silently repointed by the action owner, enabling supply-chain attacks — as seen in the trivy-action and kics-github-action compromises. Pin the reference to a full 40-character commit SHA instead, e.g. `uses: actions/checkout@8ade135a41bc03ea155e62e844d188df1ea18608`."},"properties":{},"ruleId":"yaml.github-actions.security.github-actions-mutable-action-tag.github-actions-mutable-action-tag"},{"finger