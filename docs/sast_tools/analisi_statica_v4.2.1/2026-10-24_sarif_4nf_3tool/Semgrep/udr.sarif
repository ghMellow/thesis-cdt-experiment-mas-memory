by the action owner, enabling supply-chain attacks — as seen in the trivy-action and kics-github-action compromises. Pin the reference to a full 40-character commit SHA instead, e.g. `uses: actions/checkout@8ade135a41bc03ea155e62e844d188df1ea18608`."},"properties":{},"ruleId":"yaml.github-actions.security.github-actions-mutable-action-tag.github-actions-mutable-action-tag"},{"fingerprints":{"matchBasedId/v1":"f0b6c6c24d38236aa1e68b87d49fe9ccd4605b77e1a6278a750dbf65277afcda9b2bdd60c1b55556fb164a135392b529af1f2d087f5f20d9139cb62bfaa0675d_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":".github/workflows/golangci-lint.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":34,"endLine":20,"snippet":{"text":"        uses: actions/setup-go@v5"},"startColumn":9,"startLine":20}}}],"message":{"text":"GitHub Actions step uses a mutable tag or branch reference. Tags and branch names can be silently repointed by the action owner, enabling supply-chain attacks — as seen in the trivy-action and kics-github-action compromises. Pin the reference to a full 40-character commit SHA instead, e.g. `uses: actions/checkout@8ade135a41bc03ea155e62e844d188df1ea18608`."},"properties":{},"ruleId":"yaml.github-actions.security.github-actions-mutable-action-tag.github-actions-mutable-action-tag"},{"fingerprints":{"matchBasedId/v1":"13ff29612e9ad0dc443fd2c3fb1ede7b494fad3566f363fb05c9a38b4bd93ffa8f1f722fde90f735de13279fd8d8d0c26a86fad515120bf5694e8b8fb8946340_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":".github/workflows/golangci-lint.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":34,"endLine":23,"snippet":{"text":"      - uses: actions/checkout@v4"},"startColumn":9,"startLine":23}}}],"message":{"text":"GitHub Actions step uses a mutable tag or branch reference. Tags and branch names can be silently repointed by the action owner, enabling supply-chain attacks — as seen in the trivy-action and kics-github-action compromises. Pin the reference to a full 40-character commit SHA instead, e.g. `uses: actions/checkout@8ade135a41bc03ea155e62e844d188df1ea18608`."},"properties":{},"ruleId":"yaml.github-actions.security.github-actions-mutable-action-tag.github-actions-mutable-action-tag"},{"fingerprints":{"matchBasedId/v1":"78e0e4310693d17f19b0266081a010b7a1bb32da4606a2cb1013dea17d97f663ca38bef845afd1db737bae24b8b8b47d7a7a5e4bc54e20a415d87538bd40186f_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":".github/workflows/golangci-lint.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":47,"endLine":25,"snippet":{"text":"        uses: golangci/golangci-lint-action@v9"},"startColumn":9,"startLine":25}}}],"message":{"text":"GitHub Actions step uses a mutable tag or branch reference. Tags and branch names can be silently repointed by the action owner, enabling supply-chain attacks — as seen in the trivy-action and kics-github-action compromises. Pin the reference to a full 40-character commit SHA instead, e.g. `uses: actions/checkout@8ade135a41bc03ea155e62e844d188df1ea18608`."},"properties":{},"ruleId":"yaml.github-actions.security.github-actions-mutable-action-tag.github-actions-mutable-action-tag"},{"fingerprints":{"matchBasedId/v1":"cd7981e9f571296761ddff2ccc7e9d1be28a9fb48f298aa9849c9d7a6df9fa3898c583333ce4c47b105c072175f002cabe72746f510224ad8054e085eaaa39fa_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":19,"snippet":{"text":"\tgo.mongodb.org/mongo-driver v1.17.1"},"startColumn":1,"startLine":19}}}],"message":{"text":"Affected versions of go.mongodb.org/mongo-driver and go.mongodb.org/mongo-driver/v2 are vulnerable to Permissive List of Allowed Inputs."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-da07ae4abb0340ceb591527d2495e1e4c171875b"},{"fingerprints":{"matchBasedId/v1":"4cb8ca4fc0609788219614faaac45049f27387f2ad658447a6f759226949a3105412bce5aee1ed8e0ac0b7345f5e607a1c81a25ff79519fb83ea5ff09c2a0c98_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Deserialization of Untrusted Data / Improper Preservation of Permissions. golang.org/x/crypto/ssh/agent silently dropped key constraint extensions (e.g. restrict-destination-v00@openssh.com) when forwarding keys to a remote agent, and the in-memory keyring silently ignored unsupported constraint extensions instead of rejecting them. A forwarded key intended to be restricted could therefore be used without its constraints, letting an attacker who controls the remote/jump host abuse the key against any destination it trusts."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-02ef276f-345d-4a72-a219-2c2d913c01ad"},{"fingerprints":{"matchBasedId/v1":"50fb002bfce7ead59a51b65d628971760df05e620e1c7e04f6be2073e85d116f4accbce77b53e7aaaa0d51c6cabecdba4c558ff3d30ae2b8773984e6267ed5ee_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Incorrect Type Conversion or Cast. An unauthenticated, remote attacker can send a well-crafted SSH packet that triggers an out-of-bounds slice panic in the AES-GCM packet decoder of golang.org/x/crypto/ssh, crashing the process (denial of service). AES-GCM is a default cipher, so the vulnerable decode path is reached whenever an SSH client or server connection is established with ssh.Dial, ssh.NewClientConn, or ssh.NewServerConn."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-315b77ec-61d5-4592-a479-115d5df00452"},{"fingerprints":{"matchBasedId/v1":"a0f1ad6cc29b1b94c517e871563808a158d3aa16da5d4cec7ba1446874c229807c660d1bb42ce6828491efeb30a5c8deee7c1a1e7f4d1ce41bf6e0d45e8cb9b2_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Incorrect Authorization / Incorrect Implementation of Authentication Algorithm. The golang.org/x/crypto/ssh server only enforced the \"source-address\" critical option on the public-key authentication path. When an SSH session authenticated through a non-public-key callback (password, keyboard-interactive, or GSSAPI-with-MIC) returns an ssh.Permissions value carrying a \"source-address\" critical option, the source-address restriction is silently skipped, allowing a client from a disallowed network to bypass the intended authorization control."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-63089c4e-55d0-401e-a63c-5aa02708bc94"},{"fingerprints":{"matchBasedId/v1":"04eaf625a263ee967613020020b8007ac122c20dad678b29ba8452b28129e62857b5c2274e28fe177bcef80005d8cc1ae73841733f6c2514ea0f5456402eb921_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Integer Overflow or Wraparound. An integer truncation in golang.org/x/crypto/ssh causes the internal payload-size calculation to overflow when a single Write (or WriteExtended) call on an SSH channel carries more than 4GB of data, making the write loop spin forever while sending empty packets. This affects any application that establishes an SSH client or server connection (ssh.Dial, ssh.NewClientConn, ssh.NewServerConn) and then writes a large payload to a channel or session."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-6bce5557-ea37-4670-b3c1-def6e1e7b6cb"},{"fingerprints":{"matchBasedId/v1":"33207a071b135214e65c177e37abaa3f4eb0bd04ea52ab12ee879f95c4c213e99448d79025dd155fc0683f290bd346b8feba7480c78d117d7666b58754df72e7_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Improper Restriction of Operations within the Bounds of a Memory Buffer / Missing Release of Resource after Effective Lifetime. A malicious SSH peer can send unsolicited global request responses that accumulate in the connection multiplexer's bounded internal buffer, blocking the connection's read loop. The blocked goroutine cannot be released even after calling Close(), causing a per-connection goroutine and memory leak (denial of service). Any SSH client or server connection established with golang.org/x/crypto/ssh reaches the vulnerable multiplexer."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-8c39b516-d6be-4e51-afa4-055a3dc56da7"},{"fingerprints":{"matchBasedId/v1":"98fe6ac17b0bdc7fe64f35c5a372d07f9584d85a9549c2db6e4fde669cfae21db8ad842a9881254c22e180622e8a6fe4529dc286be401110393ed8076f46ca03_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Missing Authorization. The in-memory keyring returned by golang.org/x/crypto/ssh/agent's NewKeyring() silently accepts keys with ConfirmBeforeUse set to true but never enforces the constraint. A key that the developer expects to require user confirmation before each use will instead sign operations without any confirmation, defeating the intended access control on that key."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-913e8f3a-f9f6-4d0f-aa1c-c166c69715d1"},{"fingerprints":{"matchBasedId/v1":"ad5b2dea49c4ec7d82e233154159c11a1a014a07cd903675e4c66f4aac3eea3f7079c4a2219687fd05e5e93b324807bf3b45c2b4d966c5abddc3137277e1389a_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Improper Certificate Validation. golang.org/x/crypto/ssh/knownhosts failed to validate the revocation status of a certificate authority SignatureKey, so an SSH host certificate signed by a @revoked CA was still accepted. Applications building a host key callback with knownhosts.New exercise the affected revocation-checking code path."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-9ef5c35e-a137-440d-8d5a-ebfa9a39019b"},{"fingerprints":{"matchBasedId/v1":"70df698d78bc0ebabb059a66c009faffbd08579ee052a0bf53018185fbf094bbe745cbe7963e0f9f4f1c2039b9829b6815db16160a83a93b5fa30fdbdd5f1466_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Missing Authorization. golang.org/x/crypto/ssh did not validate the User Presence flag when verifying FIDO/U2F security-key signatures (sk-ecdsa-sha2-nistp256@openssh.com and sk-ssh-ed25519@openssh.com), so signatures produced without a physical touch of the hardware key were accepted. Any code that runs the SSH handshake or verifies SSH certificates/host keys with this package reaches the flawed verification path."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-bd883eb0-57de-4dc1-abbe-b8099f45de65"},{"fingerprints":{"matchBasedId/v1":"63d4dff74907072595ae68a571d35fc607b6327a14e2a930d2a4d9fb4a2333fa55b8f6177749d36a20c73bbb5e87acc4ae6a28c0c88e42456148f60fe9debe5a_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Improper Validation of Specified Quantity in Input / Improper Verification of Cryptographic Signature. The RSA and DSA public key parsers in golang.org/x/crypto/ssh did not enforce size limits on key parameters. An attacker can supply a crafted public key with an excessively large RSA modulus or DSA parameter that causes several minutes of CPU consumption during signature verification, resulting in denial of service. This is reachable by unauthenticated clients during public key authentication."},"properties":{"exposure":"unreachable"},"ruleId":"ssc-e98e1c70-3cce-418d-961f-8b39587b8604"},{"fingerprints":{"matchBasedId/v1":"308ff82c981e8dd31f92eb6fe5e4e57f36106a13fdbe96c07e0b7057082470a4482b608905c0950d19a2ab785f580ea81db25a71b81e62ca88a4a35cb7c44bbc_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Improper Certificate Validation / Improper Preservation of Permissions."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-0842aec4076a333089e2b007bc3520788cd47d1b"},{"fingerprints":{"matchBasedId/v1":"905e295f75002e18c9cc40974ed8fbad01b3bf7c3a7d2c56ca8c5fd70fb90aaf74bdcb809af787a7984f70255bebf32189af213079a174953c9deb5364330145_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Improper Enforcement of Message Integrity During Transmission in a Communication Channel."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-7069e69355da04ee603ef7c640c31c46dd0c38cf"},{"fingerprints":{"matchBasedId/v1":"f52e6f1294fb2cb94ad1d96bc069f2cbfed85baf72fd189d3946c6b36c8cf358ae57409f4eaf0c4fc9598855ea0a5cc6cb6ecc1a6d52c87014c687eeabbf1377_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Improper Validation of Array Index."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-8d3b46adb4e848137a89bc6686610e00b2ff2e2f"},{"fingerprints":{"matchBasedId/v1":"97e18d3ddf66a4e7ddcdabce24c3585f7b0f9c72c42fd9804190540d527cd2d6f821983642fd7872b4f75ebf8f0acc43baab4a91080e2e4f26de3dda4fd14410_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":78,"snippet":{"text":"\tgolang.org/x/crypto v0.45.0 // indirect"},"startColumn":1,"startLine":78}}}],"message":{"text":"Affected versions of golang.org/x/crypto are vulnerable to Improper Certificate Validation / NULL Pointer Dereference."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-a0e6d3109b5e5d04f665021411221fb93885b588"},{"fingerprints":{"matchBasedId/v1":"db09009a109f31f4878bc768b96080f65a5a13661028d6ea0492896d4732fe1b8bc391543424e5f40832c289167aaed23e2d2227df1275f72599bd3162064c92_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"go.mod","uriBaseId":"%SRCROOT%"},"region":{"endColumn":1,"endLine":79,"snippet":{"text":"\tgolang.org/x/net v0.47.0 // indirect"},"startColumn":1,"startLine":79}}}],"message":{"text":"Affected versions of golang.org/x/net are vulnerable to Uncontrolled Resource Consumption."},"properties":{"exposure":"undetermined"},"ruleId":"ssc-parity-587e22a5b0de8ccfb3b54fd42c52234797c84552"},{"fingerprints":{"matchBasedId/v1":"625b67035e33cb7e66d91df838f2838fd8468e203e390e3e84d5fe5be66c3025b037027b2e30f03d5f46f480bae1798f4906d659087a4e8ca6450c2d50784aeb_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"internal/context/context.go","uriBaseId":"%SRCROOT%"},"region":{"endColumn":12,"endLine":6,"snippet":{"text":"\t\"math/rand\""},"startColumn":3,"startLine":6}}}],"message":{"text":"Do not use `math/rand`. Use `crypto/rand` instead."},"properties":{},"ruleId":"go.lang.security.audit.crypto.math_random.math-random-used"},{"fingerprints":{"matchBasedId/v1":"0eaf4ccd5ce2056fc0e0b16f69d3c69a53a3edffe79b4af12a5b5386f0e26adce5fb3bde8bb557334745a646c501059f549e570f0bcc30068621d09c1edecb51_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"internal/context/context.go","uriBaseId":"%SRCROOT%"},"region":{"endColumn":24,"endLine":231,"snippet":{"text":"\t\treturn context.TODO(), nil, nil"},"startColumn":10,"startLine":231}}}],"message":{"text":"Consider to use well-defined context"},"properties":{},"ruleId":"dgryski.semgrep-go.contexttodo.context-todo"},{"fingerprints":{"matchBasedId/v1":"e8fdb6e28cbceec8e05af7f22cfea77e57adaae583e99bf25b341539c4f9f500f80ee5ac7d8a585a3a9a0bcf3ec03a8c24ea0b50c247141e5847436072ccee41_0"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"internal/sbi/processor/callback.go","uriBaseId":"%SRCROOT%"},"region":{"endColumn":19,"endLine":104,"snippet":{"text":"\t\t\t\tcontext.TODO(), onDataChangeNotifyUrl, &dataChangeReq)"},"startColumn":5,"startLine":104}}}],"message":{"text":"Consider to use well-defined context"},"properties":{},"ruleId":"dgryski.semgrep-go.con